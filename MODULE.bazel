module(
    name = "bazel_routines",
    version = "0.0.0",
)

_GO_VERSION = "1.23.5"

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.0.1", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.13.0", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.53.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.42.0", dev_dependency = True)
bazel_dep(name = "aspect_rules_lint", version = "1.2.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = _GO_VERSION)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
